{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "ES2022"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "preserve",
    "allowJs": false,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "exactOptionalPropertyTypes": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "incremental": true,
    "noEmit": true,
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/*": ["./src/*"],
      "@nightlife/core": ["./src/packages/core/index.ts"],
      "@nightlife/core/*": ["./src/packages/core/*"],
      "@nightlife/ticketing": ["./src/packages/ticketing/index.ts"],
      "@nightlife/ticketing/*": ["./src/packages/ticketing/*"],
      "@nightlife/ai": ["./src/packages/ai/index.ts"],
      "@nightlife/ai/*": ["./src/packages/ai/*"],
      "@nightlife/db": ["./src/packages/db/index.ts"],
      "@nightlife/db/*": ["./src/packages/db/*"],
      "@nightlife/auth": ["./src/packages/auth/index.ts"],
      "@nightlife/auth/*": ["./src/packages/auth/*"],
      "@nightlife/channels": ["./src/packages/channels/index.ts"],
      "@nightlife/channels/*": ["./src/packages/channels/*"],
      "@nightlife/config": ["./src/packages/config/index.ts"],
      "@nightlife/config/*": ["./src/packages/config/*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
