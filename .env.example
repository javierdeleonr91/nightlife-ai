# ── base de datos ────────────────────────────────────────────────────
DATABASE_URL="postgresql://nightlife:nightlife@localhost:5432/nightlife"

# ── secretos (genera los tuyos: openssl rand -base64 48) ─────────────
AUTH_SECRET="cambia-esto-por-al-menos-32-caracteres-aleatorios"
CUSTOMER_HASH_PEPPER="cambia-esto-tambien-16-min"

APP_URL="http://localhost:3000"

# ── IA ───────────────────────────────────────────────────────────────
# Sin clave el bot sigue funcionando con plantillas y FAQ: degrada, no rompe.
LLM_API_KEY=""
LLM_MODEL="claude-sonnet-4-5"
LLM_CLASSIFIER_MODEL="claude-haiku-4-5"

# ── fuente externa ───────────────────────────────────────────────────
# URL real de contacto: va en el User-Agent con el que nos identificamos.
SOURCE_CONTACT_URL="https://nightlifeautomatico.com/bot"
SOURCE_MIN_INTERVAL_MS="3000"

# ── políticas ────────────────────────────────────────────────────────
PRICE_TTL_SECONDS="600"
CONVERSATION_RETENTION_DAYS="90"
DEFAULT_AI_DAILY_BUDGET_CENTS="500"
