// Nightlife Automatico — esquema multi-tenant
//
// Reglas del esquema:
//  1. Toda tabla con datos de un club lleva clubId indexado, aunque pudiera
//     deducirse por join. Hace el filtro barato y el fallo evidente.
//  2. Ningún dato externo se guarda como valor suelto: va como DataPoint con
//     source, confidence, lastUpdated y ttlSeconds.
//  3. Los precios no se sobreescriben: se cierra el vigente y se abre otro.
//     Sin histórico no se puede responder "¿cuánto costaba?" sin inventar.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // DATABASE_URL pasa por el pooler; DIRECT_URL va a la base sin pooler.
  // Prisma necesita la conexión directa para migraciones e introspección:
  // con pgBouncer en medio, `migrate` falla de formas poco obvias.
  // NO eliminar directUrl.
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────────────────────────────────────── enums

enum GlobalRole {
  USER
  SUPER_ADMIN
}

/// Qué eligió la persona la primera vez que entró. Se pregunta una sola vez.
enum AccountType {
  CLUB
  PROMOTER
}

enum ClubRole {
  CLUB_OWNER
  CLUB_MANAGER
}

enum ClubStatus {
  ACTIVE
  SUSPENDED
}

enum PromoterClubStatus {
  PENDING
  APPROVED
  SUSPENDED
  REJECTED
}

enum EventStatus {
  SYNCING
  ACTIVE
  PAUSED
  SOLD_OUT
  ENDED
  ERROR
}

enum SyncStatus {
  NEVER
  OK
  STALE
  FAILED
  UNSUPPORTED
}

enum IntegrationProvider {
  FOURVENUES
}

enum IntegrationEnvironment {
  ALPHA
  PRODUCTION
}

enum IntegrationStatus {
  NOT_CONNECTED
  CONNECTED
  INVALID_KEY
  ERROR
}

enum TicketTypeStatus {
  AVAILABLE
  SOLD_OUT
  UPCOMING
  CLOSED
  UNKNOWN
}

enum DataSource {
  FOURVENUES
  CLUB_CONFIG
  FAQ
  VIP_CONFIG
  CONVERSATION_CONTEXT
  MANUAL
}

enum ConversationStatus {
  AI_ACTIVE
  WAITING_HUMAN
  HUMAN_ACTIVE
  POTENTIAL_PURCHASE
  CLOSED
}

enum MessageRole {
  CUSTOMER
  ASSISTANT
  HUMAN_AGENT
  SYSTEM
}

enum ChannelType {
  WEBCHAT
  WHATSAPP
  INSTAGRAM
}

/// De quién es un canal y todo lo que cuelga de él.
///
/// No es un campo descriptivo: `ownerType` + `ownerClubId`/`ownerPromoterId`
/// son las columnas que leen las políticas de RLS. Cambiarlos cambia quién
/// ve qué, y por eso la base de datos los hace inmutables (16 triggers,
/// ver prisma/migrations/manual/001-channel-owner.sql).
enum ChannelOwnerType {
  CLUB
  PROMOTER
}

enum ChannelStatus {
  DISCONNECTED
  CONNECTED
  ERROR
}

enum FollowUpStatus {
  SUGGESTED
  DISMISSED
  SENT
}

enum SubscriptionOwnerType {
  CLUB
  PROMOTER
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
}

// ─────────────────────────────────────────────────────────── identidad

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  /// Opcional a propósito: quien entra con Google o Apple no tiene contraseña.
  /// `null` significa «esta cuenta solo entra por proveedor», y el login por
  /// email la rechaza en vez de compararla contra una cadena vacía.
  passwordHash String?
  name         String
  globalRole   GlobalRole @default(USER)
  // Se guarda en el primer registro para no volver a preguntarlo nunca.
  accountType  AccountType?
  locale       String     @default("es")
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  clubMemberships ClubMember[]
  promoter        Promoter?
  auditLogs       AuditLog[]
  identities      UserIdentity[]

  @@map("users")
}

/// Cómo entra una persona: contraseña, Google o Apple.
///
/// Una fila por proveedor y usuario. La clave real es (provider, subject): el
/// `sub` que da el proveedor es lo único estable — el email de una cuenta de
/// Google puede cambiar, y Apple entrega un relay que tampoco es fiable como
/// identificador.
///
/// Aquí NO se guardan tokens de acceso. Usamos OAuth para saber quién eres, no
/// para leer tu Gmail ni tu iCloud: el token cumple su función en el callback y
/// se descarta. Guardar lo que no se necesita solo crea algo que robar.
model UserIdentity {
  id         String   @id @default(cuid())
  userId     String
  /// "google" | "apple" | "password"
  provider   String
  /// El `sub` del proveedor. Para "password" es el propio id del usuario.
  subject    String
  /// Email tal y como lo dio el proveedor la primera vez. Apple solo lo manda
  /// en la primera autorización, así que si no se guarda aquí se pierde.
  email      String?
  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, subject])
  @@index([userId])
  @@map("user_identities")
}

model Club {
  id           String     @id @default(cuid())
  slug         String     @unique
  name         String
  description  String?
  city         String
  address      String?
  phone        String?
  whatsapp     String?
  instagram    String?
  website      String?
  timezone     String     @default("Europe/Madrid")
  openingHours String?
  minAge       Int?
  dressCode    String?
  policies     String?
  status       ClubStatus @default(ACTIVE)
  botEnabled   Boolean    @default(false)
  /// Igual que en Promoter: solo para reanudar el onboarding.
  onboardingStep Int      @default(0)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  members       ClubMember[]
  events        Event[]
  promoters     PromoterClub[]
  invites       ClubInvite[]
  brand         BrandSettings?
  integrations  ClubIntegration[]
  faqs          FAQ[]
  knowledge     KnowledgeItem[]
  vipOptions    VIPOption[]
  channels      Channel[]
  customers     Customer[]
  conversations Conversation[]
  aiConfig      AiConfig?

  /// Relaciones de propiedad polimórfica. Van con nombre porque hay más de
  /// una FK desde la misma tabla hacia Club (dueño, contexto y la legacy).
  ownedCustomers     Customer[]           @relation("CustomerOwnerClub")
  ownedConversations Conversation[]       @relation("ConversationOwnerClub")
  contextConversations Conversation[]     @relation("ConversationContextClub")
  ownedMessages      Message[]            @relation("MessageOwnerClub")
  ownedFollowUps     FollowUp[]           @relation("FollowUpOwnerClub")
  ownedAiLogs        AiRequestLog[]       @relation("AiLogOwnerClub")
  ownedUnanswered    UnansweredQuestion[] @relation("UnansweredOwnerClub")
  ownedFeedback      BetaFeedback[]       @relation("FeedbackOwnerClub")

  @@index([status])
  @@map("clubs")
}

model ClubMember {
  id        String   @id @default(cuid())
  userId    String
  clubId    String
  role      ClubRole
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  club Club @relation(fields: [clubId], references: [id], onDelete: Cascade)

  @@unique([userId, clubId])
  @@index([clubId])
  @@map("club_members")
}

model Promoter {
  id          String   @id @default(cuid())
  userId      String   @unique
  slug        String   @unique
  displayName String
  photoUrl    String?
  bio         String?
  city        String?
  instagram   String?
  whatsapp    String?
  /// Link personal de Fourvenues del RRPP, tal y como se lo dio Fourvenues.
  /// Lo pega él. Nosotros no lo componemos, no le añadimos parámetros y no
  /// deducimos nada de él. Ver normalizePromoterLink en core/checkout.ts.
  fourvenuesUrl String?

  /// Portada del perfil público. Sin ella la página se ve vacía; con ella
  /// parece nightlife. Vive en el bucket profile-media, igual que photoUrl.
  coverImageUrl String?

  /// Qué enseña su perfil público. El WhatsApp es su teléfono personal, así
  /// que arranca en false: publicar el móvil de alguien sin que lo pida es un
  /// error que no se deshace.
  showInstagram Boolean @default(true)
  showWhatsapp  Boolean @default(false)
  showCity      Boolean @default(true)

  /// Solo sirve para reanudar el onboarding donde lo dejó. NO es la fuente de
  /// verdad de si algo está configurado: eso se calcula de los datos reales
  /// (ver core/completion.ts).
  onboardingStep Int @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  clubs         PromoterClub[]
  events        PromoterEvent[]
  fourvenuesEvents PromoterFourvenuesEvent[]
  conversations Conversation[]
  channels      Channel[]

  ownedCustomers     Customer[]           @relation("CustomerOwnerPromoter")
  ownedConversations Conversation[]       @relation("ConversationOwnerPromoter")
  ownedMessages      Message[]            @relation("MessageOwnerPromoter")
  ownedFollowUps     FollowUp[]           @relation("FollowUpOwnerPromoter")
  ownedAiLogs        AiRequestLog[]       @relation("AiLogOwnerPromoter")
  ownedUnanswered    UnansweredQuestion[] @relation("UnansweredOwnerPromoter")
  ownedFeedback      BetaFeedback[]       @relation("FeedbackOwnerPromoter")
  knowledge          PromoterKnowledge[]
  faqs               PromoterFAQ[]

  @@map("promoters")
}

/// Invitación de un club a un RRPP.
///
/// El código ES el permiso. El promoter lo canjea y el servidor deduce de él a
/// qué club entra: el navegador nunca manda un `clubId`, así que cambiar un id
/// en una petición no sirve para colarse en otro club.
///
/// Revocable y con caducidad porque un código circula por WhatsApp y acaba
/// donde no debe. `maxUses = 0` significa sin límite: sirve para el enlace que
/// un club pone en su grupo de RRPPs.
model ClubInvite {
  id          String    @id @default(cuid())
  clubId      String
  /// 8 caracteres, alfabeto sin 0/O/1/I/L. Ver core/invite.ts.
  code        String    @unique
  /// Quién lo creó, para poder auditar quién metió a quién.
  createdById String
  expiresAt   DateTime?
  /// 0 = usos ilimitados.
  maxUses     Int       @default(1)
  usedCount   Int       @default(0)
  revokedAt   DateTime?
  note        String?
  createdAt   DateTime  @default(now())

  club Club @relation(fields: [clubId], references: [id], onDelete: Cascade)

  @@index([clubId, revokedAt])
  @@map("club_invites")
}

model PromoterClub {
  id          String             @id @default(cuid())
  promoterId  String
  clubId      String
  status      PromoterClubStatus @default(PENDING)
  canEditEvents Boolean          @default(false)
  requestedAt DateTime           @default(now())
  approvedAt  DateTime?
  /// Con qué invitación entró, si entró por una. Sirve para auditar y para
  /// poder deshacer una invitación que se compartió de más.
  invitedVia  String?

  promoter Promoter @relation(fields: [promoterId], references: [id], onDelete: Cascade)
  club     Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)

  @@unique([promoterId, clubId])
  @@index([clubId, status])
  @@map("promoter_clubs")
}

model PromoterEvent {
  id         String   @id @default(cuid())
  promoterId String
  eventId    String
  clubId     String
  // URL de checkout propia del promoter para ESTE evento, cuando Fourvenues se
  // la haya dado a él. Es una URL real que él aporta o que descubrimos de su
  // enlace: nunca la componemos nosotros añadiendo parámetros.
  //
  // Si está vacía, la compra usa el checkout oficial del club (ver §50 de la
  // spec y resolveCheckoutUrl en packages/core/checkout.ts).
  checkoutUrl String?
  // Telemetría interna de producto: cuántas veces se ha pulsado COMPRAR desde
  // este link. Sirve para depurar y para saber si el producto funciona. NO es
  // un contador de ventas ni se enseña al promoter como tal.
  clickCount Int      @default(0)
  createdAt  DateTime @default(now())

  promoter Promoter @relation(fields: [promoterId], references: [id], onDelete: Cascade)
  event    Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([promoterId, eventId])
  @@index([clubId])
  @@map("promoter_events")
}

model PromoterFourvenuesEvent {
  id                String   @id @default(cuid())
  promoterId        String
  sourceUrl         String
  checkoutUrl       String
  name              String
  startsAt          DateTime
  venueName         String?
  imageUrl          String?
  djLineup          String[] @default([])
  currentPriceCents Int?
  soldOut           Boolean  @default(false)
  isActive          Boolean  @default(true)
  lastSeenAt        DateTime @default(now())
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  promoter Promoter @relation(fields: [promoterId], references: [id], onDelete: Cascade)

  @@unique([promoterId, sourceUrl])
  @@index([promoterId, startsAt])
  @@index([promoterId, isActive, startsAt])
  @@map("promoter_fourvenues_events")
}

// ─────────────────────────────────────────────────────────── eventos

model Event {
  id          String      @id @default(cuid())
  clubId      String
  name        String
  slug        String
  description String?
  startsAt    DateTime
  doorsAt     DateTime?
  endsAt      DateTime?
  djLineup    String[]    @default([])
  imageUrl    String?
  ticketUrl   String?
  status      EventStatus @default(ACTIVE)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  club           Club            @relation(fields: [clubId], references: [id], onDelete: Cascade)
  source         EventSource?
  ticketTypes    TicketType[]
  vipOptions     VIPOption[]
  promoterEvents PromoterEvent[]

  @@unique([clubId, slug])
  @@index([clubId, startsAt])
  @@index([clubId, status])
  @@map("events")
}

/// Credenciales de una integración de un club. Hoy solo Fourvenues.
///
/// La API key vive aquí CIFRADA (AES-256-GCM, ver packages/core/secret-box.ts)
/// y no sale nunca hacia el navegador: la UI solo recibe `keyHint`, que son los
/// cuatro últimos caracteres. Tampoco se escribe en logs ni en `lastError`:
/// los errores se guardan ya traducidos a un código nuestro.
///
/// `clubId` va en cada consulta, como en el resto del esquema: las credenciales
/// de un club no pueden alcanzarse desde el contexto de otro.
model ClubIntegration {
  id            String                 @id @default(cuid())
  clubId        String
  provider      IntegrationProvider    @default(FOURVENUES)
  environment   IntegrationEnvironment @default(PRODUCTION)
  status        IntegrationStatus      @default(NOT_CONNECTED)

  /// Texto sellado por secret-box. Nunca en claro, nunca en una respuesta API.
  encryptedKey  String
  /// «••••cdef». Lo único del secreto que puede ver el cliente.
  keyHint       String

  /// Canal/equipo elegido dentro de la organización de Fourvenues.
  channelId     String?
  channelName   String?

  lastVerifiedAt DateTime?
  lastSyncedAt   DateTime?
  /// Código de error nuestro (INVALID_KEY, RATE_LIMITED…), jamás el cuerpo de
  /// la respuesta de Fourvenues.
  lastErrorCode  String?
  eventsSynced   Int      @default(0)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  club Club @relation(fields: [clubId], references: [id], onDelete: Cascade)

  @@unique([clubId, provider])
  @@index([clubId])
  @@map("club_integrations")
}

model EventSource {
  id           String     @id @default(cuid())
  eventId      String     @unique
  clubId       String
  provider     String // "fourvenues-public" | "fourvenues-api" | "manual"
  externalId   String?
  sourceUrl    String?
  lastSyncedAt DateTime?
  syncStatus   SyncStatus @default(NEVER)
  lastError    String?
  refreshEverySeconds Int @default(900)

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([clubId])
  @@index([syncStatus, lastSyncedAt])
  @@map("event_sources")
}

model TicketType {
  id         String           @id @default(cuid())
  eventId    String
  clubId     String
  externalId String?
  name       String
  sortOrder  Int              @default(0)
  status     TicketTypeStatus @default(UNKNOWN)
  createdAt  DateTime         @default(now())

  event  Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  prices TicketPrice[]

  @@index([eventId, sortOrder])
  @@index([clubId])
  @@map("ticket_types")
}

// Histórico de precios. Nunca se hace UPDATE sobre el importe:
// se cierra el vigente (validTo, isCurrent=false) y se inserta el nuevo.
model TicketPrice {
  id           String   @id @default(cuid())
  ticketTypeId String
  clubId       String
  amountCents  Int
  currency     String   @default("EUR")
  isCurrent    Boolean  @default(true)
  validFrom    DateTime @default(now())
  validTo      DateTime?
  source       DataSource @default(FOURVENUES)
  confidence   Float      @default(0.9)

  ticketType TicketType @relation(fields: [ticketTypeId], references: [id], onDelete: Cascade)

  @@index([ticketTypeId, isCurrent])
  @@index([clubId])
  @@map("ticket_prices")
}

// Todo dato externo vive aquí con su procedencia y su caducidad.
// El motor de IA solo puede afirmar lo que salga de un DataPoint fresco.
model DataPoint {
  id          String     @id @default(cuid())
  clubId      String
  entityType  String // "EVENT" | "TICKET_TYPE" | "CLUB"
  entityId    String
  field       String // "currentPrice" | "availability" | "dj" | ...
  valueJson   Json
  source      DataSource
  confidence  Float
  ttlSeconds  Int
  lastUpdated DateTime   @default(now())

  @@unique([entityType, entityId, field])
  @@index([clubId, entityType, entityId])
  @@map("data_points")
}

model VIPOption {
  id             String   @id @default(cuid())
  clubId         String
  eventId        String?
  name           String
  description    String?
  priceCents     Int?
  currency       String   @default("EUR")
  minPax         Int      @default(1)
  maxPax         Int
  includes       String[] @default([])
  conditions     String?
  bookingContact String?
  isActive       Boolean  @default(true)
  sortOrder      Int      @default(0)

  club  Club   @relation(fields: [clubId], references: [id], onDelete: Cascade)
  event Event? @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([clubId, isActive])
  @@index([eventId])
  @@map("vip_options")
}

// ─────────────────────────────────────────────────────────── conocimiento

model FAQ {
  id        String   @id @default(cuid())
  clubId    String
  question  String
  answer    String
  keywords  String[] @default([])
  intent    String?
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)

  club Club @relation(fields: [clubId], references: [id], onDelete: Cascade)

  @@index([clubId, isActive])
  @@map("faqs")
}

model KnowledgeItem {
  id       String   @id @default(cuid())
  clubId   String
  title    String
  body     String
  tags     String[] @default([])
  isActive Boolean  @default(true)

  club Club @relation(fields: [clubId], references: [id], onDelete: Cascade)

  @@index([clubId, isActive])
  @@map("knowledge_items")
}

model AiConfig {
  id              String  @id @default(cuid())
  clubId          String  @unique
  tone            String  @default("nightlife")
  primaryLanguage String  @default("es")
  autoDetectLanguage Boolean @default(true)
  greeting        String?
  handoffMessage  String?
  offHoursMessage String?
  dailyBudgetCents Int    @default(500)
  spentTodayCents Int     @default(0)
  budgetResetAt   DateTime @default(now())

  club Club @relation(fields: [clubId], references: [id], onDelete: Cascade)

  @@map("ai_configs")
}

model BrandSettings {
  id              String  @id @default(cuid())
  clubId          String  @unique
  logoUrl         String?
  coverImageUrl   String?
  faviconUrl      String?
  primaryColor    String  @default("#FF2D6F")
  secondaryColor  String  @default("#7C3AED")
  backgroundColor String  @default("#0B0B10")
  textColor       String  @default("#F5F3F7")
  fontFamily      String  @default("Inter")
  buttonStyle     String  @default("solid")
  borderRadius    Int     @default(12)
  customDomain    String? @unique

  club Club @relation(fields: [clubId], references: [id], onDelete: Cascade)

  @@map("brand_settings")
}

// ─────────────────────────────────────────────────────────── conversación

model Customer {
  id String @id @default(cuid())

  /// Dueño denormalizado desde el canal. No se manda desde el frontend: si
  /// llega vacío lo deriva un trigger, y si llega distinto al del canal se
  /// rechaza la fila.
  ownerType       ChannelOwnerType
  ownerClubId     String?
  ownerPromoterId String?

  /// El canal por el que escribe. INMUTABLE: moverlo cambiaría el dueño por
  /// la puerta de atrás.
  channelId String

  /// Identidad externa con alcance de canal. El mismo Instagram escribiendo
  /// a Javier y a MON son dos clientes distintos, y es lo correcto: sus
  /// conversaciones no deben cruzarse.
  /// Hash con pepper para buscar; la referencia real va cifrada.
  externalUserHash String
  externalUserRef  String?

  displayName   String?
  locale        String    @default("es")
  consentAt     DateTime?
  consentSource String?
  createdAt     DateTime  @default(now())

  /// ── LEGACY ────────────────────────────────────────────────────────
  /// Se quedan hasta la migración 002, tras días de rodaje. No las use el
  /// código nuevo: el inquilino es ownerClubId/ownerPromoterId.
  clubId             String?
  channelType        ChannelType?
  externalHandleHash String?

  channel       Channel        @relation(fields: [channelId], references: [id], onDelete: NoAction)
  ownerClub     Club?          @relation("CustomerOwnerClub", fields: [ownerClubId], references: [id], onDelete: Cascade)
  ownerPromoter Promoter?      @relation("CustomerOwnerPromoter", fields: [ownerPromoterId], references: [id], onDelete: Cascade)
  club          Club?          @relation(fields: [clubId], references: [id], onDelete: Cascade)
  conversations Conversation[]

  @@unique([channelId, externalUserHash], map: "customers_channel_hash_key")
  @@unique([clubId, channelType, externalHandleHash])
  @@index([ownerClubId], map: "customers_owner_club_idx")
  @@index([ownerPromoterId], map: "customers_owner_promoter_idx")
  @@index([clubId])
  @@map("customers")
}

model Conversation {
  id String @id @default(cuid())

  /// DE QUIÉN es la conversación. Derivado del canal, inmutable, y lo único
  /// que mira RLS.
  ownerType       ChannelOwnerType
  ownerClubId     String?
  ownerPromoterId String?

  /// DE QUÉ CLUB se está hablando. No es lo mismo y no se puede confundir:
  /// un cliente escribe al Instagram de Javier (owner = Javier) y pregunta
  /// por MON (contexto = MON). MON NO puede leer ese DM.
  ///
  /// Sí es mutable —la conversación cambia de tema— y NO aparece en ninguna
  /// política de RLS. Hay un test que lo comprueba.
  contextClubId String?

  /// El canal por el que llegó. INMUTABLE, igual que en Customer.
  channelId String

  customerId     String
  channelType    ChannelType        @default(WEBCHAT)
  status         ConversationStatus @default(AI_ACTIVE)
  /// Idioma detectado del cliente. La IA responde en el idioma del mensaje,
  /// no en el del panel.
  locale         String?
  lastIntent     String?
  eventFocusId   String?
  partySize      Int?
  purchaseIntent Boolean            @default(false)
  ctaClicked     Boolean            @default(false)
  lastMessageAt  DateTime           @default(now())
  createdAt      DateTime           @default(now())
  /// Retención GDPR: un job diario anonimiza lo que pasa de esta fecha.
  expiresAt      DateTime

  /// ── LEGACY ────────────────────────────────────────────────────────
  /// `promoterId` marcaba por quién llegó el cliente, no de quién era la
  /// conversación. No se convirtió en dueño y no debe usarse como tal.
  clubId     String?
  promoterId String?

  channel       Channel   @relation(fields: [channelId], references: [id], onDelete: NoAction)
  ownerClub     Club?     @relation("ConversationOwnerClub", fields: [ownerClubId], references: [id], onDelete: Cascade)
  ownerPromoter Promoter? @relation("ConversationOwnerPromoter", fields: [ownerPromoterId], references: [id], onDelete: Cascade)
  contextClub   Club?     @relation("ConversationContextClub", fields: [contextClubId], references: [id], onDelete: SetNull)
  club          Club?     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  promoter      Promoter? @relation(fields: [promoterId], references: [id], onDelete: SetNull)
  customer      Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)

  messages   Message[]
  followUp   FollowUp?
  aiLogs     AiRequestLog[]
  unanswered UnansweredQuestion[]

  /// La usa la FK compuesta messages(conversationId, ownerType) para que el
  /// tipo de dueño de un mensaje no pueda divergir del de su conversación.
  @@unique([id, ownerType], map: "conversations_id_owner_type_key")
  @@index([ownerClubId, status], map: "conversations_owner_club_status_idx")
  @@index([ownerClubId, lastMessageAt], map: "conversations_owner_club_last_idx")
  @@index([ownerPromoterId, status], map: "conversations_owner_promoter_status_idx")
  @@index([ownerPromoterId, lastMessageAt], map: "conversations_owner_promoter_last_idx")
  @@index([contextClubId], map: "conversations_context_club_idx")
  @@index([clubId, status])
  @@index([clubId, lastMessageAt])
  @@index([promoterId])
  @@index([expiresAt])
  @@map("conversations")
}

model Message {
  id String @id @default(cuid())

  /// Derivado de la conversación. Inmutable, igual que conversationId.
  ownerType       ChannelOwnerType
  ownerClubId     String?
  ownerPromoterId String?

  conversationId String
  role           MessageRole
  content        String
  intent         String?
  /// Provenance interno: de dónde salió cada afirmación. No se muestra al
  /// cliente; sirve para depurar por qué la IA dijo lo que dijo.
  provenanceJson Json?
  model            String?
  tokensIn         Int?
  tokensOut        Int?
  latencyMs        Int?
  validationPassed Boolean?
  createdAt        DateTime @default(now())

  /// ── LEGACY ────────────────────────────────────────────────────────
  clubId String?

  conversation  Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  ownerClub     Club?        @relation("MessageOwnerClub", fields: [ownerClubId], references: [id], onDelete: Cascade)
  ownerPromoter Promoter?    @relation("MessageOwnerPromoter", fields: [ownerPromoterId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([ownerClubId], map: "messages_owner_club_idx")
  @@index([ownerPromoterId], map: "messages_owner_promoter_idx")
  @@index([clubId])
  @@map("messages")
}

model Channel {
  id String @id @default(cuid())

  /// Propiedad polimórfica. Exactamente uno de clubId/promoterId, según
  /// ownerType — lo garantiza el CHECK `channels_one_owner` en PostgreSQL.
  /// Los tres son INMUTABLES: para cambiar de manos se desconecta el canal y
  /// se vuelve a conectar, que crea filas nuevas.
  ownerType  ChannelOwnerType
  /// LEGACY + dueño: era la única columna de propiedad y sigue siéndolo
  /// cuando ownerType = CLUB. Nullable desde 001 porque un canal de RRPP no
  /// tiene club.
  clubId     String?
  promoterId String?

  type                 ChannelType
  status               ChannelStatus @default(DISCONNECTED)
  externalAccountId    String?
  /// Nombre de la cuenta tal y como lo devuelve Meta (@mon_madrid). Solo
  /// para que el usuario reconozca qué ha conectado.
  displayName          String?
  /// Cifrado en reposo (AES-GCM). Nunca sale al frontend.
  credentialsEncrypted String?
  tokenExpiresAt       DateTime?
  webhookSecret        String?
  /// Si está en false el mensaje entra igual pero la IA no responde sola.
  autoReply            Boolean       @default(true)
  /// Cómo se conectó WhatsApp: coexistencia con la app de WhatsApp Business,
  /// o número dedicado. Cambia el onboarding y lo que se le puede prometer.
  waMode               String?
  /// Último código de error de Meta. Sirve para enseñar «Reconectar» en vez
  /// de un estado verde mentiroso.
  lastErrorCode        String?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  club          Club?          @relation(fields: [clubId], references: [id], onDelete: Cascade)
  promoter      Promoter?      @relation(fields: [promoterId], references: [id], onDelete: Cascade)
  conversations Conversation[]
  customers     Customer[]

  /// Una cuenta externa no puede estar conectada dos veces. NULL cuenta como
  /// distinto en PostgreSQL, así que varios canales DESCONECTADOS conviven.
  @@unique([type, externalAccountId], map: "channels_type_external_key")
  @@unique([promoterId, type], map: "channels_promoter_type_key")
  @@unique([clubId, type])
  @@index([ownerType, status], map: "channels_owner_status_idx")
  @@map("channels")
}

model FollowUp {
  id String @id @default(cuid())

  ownerType       ChannelOwnerType
  ownerClubId     String?
  ownerPromoterId String?

  conversationId   String         @unique
  suggestedMessage String
  status           FollowUpStatus @default(SUGGESTED)
  sentAt           DateTime?
  sentByUserId     String?
  createdAt        DateTime       @default(now())

  /// ── LEGACY ────────────────────────────────────────────────────────
  clubId     String?
  promoterId String?

  conversation  Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  ownerClub     Club?        @relation("FollowUpOwnerClub", fields: [ownerClubId], references: [id], onDelete: Cascade)
  ownerPromoter Promoter?    @relation("FollowUpOwnerPromoter", fields: [ownerPromoterId], references: [id], onDelete: Cascade)

  @@index([clubId, status])
  @@map("follow_ups")
}

// ─────────────────────────────────────────────────────────── plataforma

// ─────────────────────────────────────────────────────────── suscripciones
//
// MODELO COMERCIAL — la regla que gobierna todo lo de abajo:
//
//   CLUB      paga una suscripción a la plataforma (software)
//   PROMOTER  paga una suscripción a la plataforma (software)
//   CLIENTE   paga su entrada a Fourvenues
//   FOURVENUES gestiona ticketing, cobro y cualquier liquidación
//
// La plataforma NUNCA toca el dinero de las entradas. No hay comisiones, ni
// payouts, ni wallets, ni saldos, ni revenue sharing, ni liquidaciones al
// promoter. El único dinero que existe en este esquema es el que un club o un
// promoter nos paga a nosotros por usar el software.
//
// Si alguna vez aparece aquí un modelo tipo Payout, Commission o Balance, es
// que el producto se ha desviado: somos una empresa de software, no un
// intermediario financiero.

model Plan {
  id   String @id @default(cuid())
  code String @unique // PROMOTER_FREE | PROMOTER_PRO | CLUB_STARTER | CLUB_PRO | CLUB_PREMIUM
  name String
  audience SubscriptionOwnerType
  // Precio de NUESTRO software, no de las entradas.
  priceCents Int     @default(0)
  currency   String  @default("EUR")
  interval   String  @default("month")
  // Features y límites viven en datos para poder cambiar planes sin desplegar.
  features Json
  limits   Json
  isActive Boolean @default(true)
  sortOrder Int    @default(0)

  subscriptions Subscription[]

  @@map("plans")
}

model Subscription {
  id        String                @id @default(cuid())
  ownerType SubscriptionOwnerType
  ownerId   String // clubId o promoterId
  planId    String
  status    SubscriptionStatus    @default(TRIALING)
  // Referencia en la pasarela (Stripe en Fase 5). Cobramos software.
  externalRef String?
  startedAt DateTime              @default(now())
  trialEndsAt DateTime?
  currentPeriodEnd DateTime?
  canceledAt DateTime?

  plan Plan @relation(fields: [planId], references: [id])

  @@unique([ownerType, ownerId])
  @@index([status])
  @@map("subscriptions")
}


model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  clubId     String?
  action     String
  targetType String?
  targetId   String?
  reason     String?
  ip         String?
  meta       Json?
  createdAt  DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([clubId, createdAt])
  @@index([actorId, createdAt])
  @@map("audit_logs")
}

// Observabilidad de IA. Sin texto del cliente: solo metadatos.
model AiRequestLog {
  id String @id @default(cuid())

  /// Con conversación, el dueño se deriva de ella. Sin conversación (una
  /// consulta suelta) tiene que venir del contexto de servidor: el trigger
  /// rechaza la fila antes que inventárselo.
  ownerType       ChannelOwnerType
  ownerClubId     String?
  ownerPromoterId String?

  conversationId   String?
  intent           String?
  resolvedBy       String // "ROUTER" | "FAQ" | "TEMPLATE" | "LLM"
  sources          String[] @default([])
  model            String?
  tokensIn         Int?
  tokensOut        Int?
  latencyMs        Int?
  validationPassed Boolean?
  validationErrors String[] @default([])
  error            String?
  createdAt        DateTime @default(now())

  /// ── LEGACY ────────────────────────────────────────────────────────
  clubId     String?
  promoterId String?

  conversation  Conversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  ownerClub     Club?         @relation("AiLogOwnerClub", fields: [ownerClubId], references: [id], onDelete: Cascade)
  ownerPromoter Promoter?     @relation("AiLogOwnerPromoter", fields: [ownerPromoterId], references: [id], onDelete: Cascade)

  @@index([clubId, createdAt])
  @@map("ai_request_logs")
}

// ══════════════════════════════════════════════════════════════════════
// Beta: aprendizaje del asistente y feedback
//
// Tablas NUEVAS. Las crea prisma/migrations/manual/010-beta-tables.sql.
// No tocan nada existente y no borran ninguna columna legacy: la limpieza
// de legacy sigue siendo una migración aparte y posterior.
// ══════════════════════════════════════════════════════════════════════

enum UnansweredStatus {
  OPEN
  ANSWERED
  DISMISSED
}

/// Lo que la IA no supo responder.
///
/// Es el corazón del bucle de mejora de la beta y la razón de que el
/// asistente pueda no saber algo sin quedar mal: en vez de inventarse una
/// respuesta, la guarda aquí y el Club o el RRPP la contesta. A partir de
/// ese momento la misma pregunta —dicha como sea— ya se responde sola.
model UnansweredQuestion {
  id String @id @default(cuid())

  ownerType       ChannelOwnerType
  ownerClubId     String?
  ownerPromoterId String?

  conversationId String?
  channelType    ChannelType?
  /// Tal y como la escribió el cliente. Sin limpiar: la forma real en que la
  /// gente pregunta es justo lo que hay que aprender.
  originalQuestion String
  detectedIntent   String?
  /// Por qué no se pudo responder: NO_DATA | STALE_DATA | AMBIGUOUS | NO_LLM
  reason     String?
  status     UnansweredStatus @default(OPEN)
  /// Lo que contestó el humano. Al guardarlo se crea también la FAQ.
  answer     String?
  answeredBy String?
  createdAt  DateTime  @default(now())
  resolvedAt DateTime?

  conversation  Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  ownerClub     Club?         @relation("UnansweredOwnerClub", fields: [ownerClubId], references: [id], onDelete: Cascade)
  ownerPromoter Promoter?     @relation("UnansweredOwnerPromoter", fields: [ownerPromoterId], references: [id], onDelete: Cascade)

  @@index([ownerClubId, status], map: "unanswered_owner_club_status_idx")
  @@index([ownerPromoterId, status], map: "unanswered_owner_promoter_status_idx")
  @@map("unanswered_questions")
}

enum FeedbackKind {
  ERROR
  SUGGESTION
  INTEGRATION
  OTHER
}

/// Feedback de los testers del piloto. Deliberadamente mínimo: cuatro tipos,
/// un texto y de dónde venía. Un sistema más grande no se llenaría.
model BetaFeedback {
  id String @id @default(cuid())

  ownerType       ChannelOwnerType
  ownerClubId     String?
  ownerPromoterId String?

  userId    String?
  kind      FeedbackKind
  message   String
  /// La ruta desde la que se envió. Sin esto, la mitad del feedback empieza
  /// por «en la pantalla esa de los eventos...».
  path      String?
  createdAt DateTime     @default(now())

  ownerClub     Club?     @relation("FeedbackOwnerClub", fields: [ownerClubId], references: [id], onDelete: Cascade)
  ownerPromoter Promoter? @relation("FeedbackOwnerPromoter", fields: [ownerPromoterId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@map("beta_feedback")
}

/// Conocimiento propio de un RRPP: cómo comprar con él, su contacto, cómo
/// funciona su lista.
///
/// NO puede sobrescribir las reglas oficiales de un club. Eso lo garantiza
/// el orden de autoridad en @nightlife/ai/knowledge, no la tabla.
model PromoterKnowledge {
  id         String   @id @default(cuid())
  promoterId String
  title      String
  body       String
  tags       String[] @default([])
  isActive   Boolean  @default(true)

  promoter Promoter @relation(fields: [promoterId], references: [id], onDelete: Cascade)

  @@index([promoterId, isActive], map: "promoter_knowledge_active_idx")
  @@map("promoter_knowledge")
}

model PromoterFAQ {
  id         String   @id @default(cuid())
  promoterId String
  question   String
  answer     String
  keywords   String[] @default([])
  intent     String?
  isActive   Boolean  @default(true)
  sortOrder  Int      @default(0)

  promoter Promoter @relation(fields: [promoterId], references: [id], onDelete: Cascade)

  @@index([promoterId, isActive], map: "promoter_faqs_active_idx")
  @@map("promoter_faqs")
}
